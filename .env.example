# Copy this file to .env and fill in the values. Never share or commit your .env.

# --- Required ---
DISCORD_TOKEN=            # Discord Developer Portal -> your app -> Bot -> Reset Token

# Channels, roles and co-owners are NOT set here any more: the server's owner or an
# Administrator picks them in Discord with the setup command. Type  .setup  to see them all.

# --- Running next to another bot on the same machine ---
# Each bot needs its own dashboard port.
DASHBOARD_PORT=3001
# DASHBOARD_ENABLED=false   # uncomment to turn the web dashboard off
DASHBOARD_ACCESS=           # optional: who can log into the web dashboard, e.g. 123456789012345678:cooper

# --- Optional extras ---
REMOVE_BG_API_KEY=          # for .rbg (free key at remove.bg)
LASTFM_API_KEY=             # for the Last.fm commands
LASTFM_API_SECRET=
ANTHROPIC_API_KEY=          # for the AI chat feature (get an API key at console.anthropic.com)
CLAUDE_ASK_ENABLED=false    # set to true to chat by mentioning/replying to the bot or using .claude
